# This file is responsible for defining stage configuration used in AWS deployments.
# Config is mapped to TypeScript in ../src/infra/stage.ts . From ../src/infra/stage.ts you can find where the values are referenced relatively easily.
# Config should be safe to commit; don't store secret values here, just ARNs for secret value retrieval later on!
#
# Stages: Deployments with unique configuration.
# You can deploy multiple configurations regardless if you have 1 AWS account or many.
# For example, if dev/staging/prod were the stack suffixes: aws-spatial-dev-app, aws-spatial-staging-app, aws-spatial-prod-app.
#
# Deploy IDs: Unique deployments of the same stage's configuration, acts as CDK qualifier.
# For example, if Alice and Bob share 1 AWS account: aws-spatial-dev-app-alice, aws-spatial-dev-app-bob.
# For example, if Alice and Bob both have their own AWS account, nothing changes above;
#  the stacks just exist in separate AWS accounts.
aws_cdk_policy_arn=arn:aws:iam::aws:policy/AdministratorAccess

# This prefix will be prepended to all CloudFormation stacks created.
aws_cfn_prefix=pvagls

aws_cdk_toolkit_cfn_stack_suffix=cdk-toolkit
aws_cicd_cfn_stack_suffix=cicd
aws_backend_cfn_stack_suffix=backend
aws_frontend_waf_cfn_stack_suffix=frontend-waf
aws_frontend_cfn_stack_suffix=frontend

# For ASCII art, see: https://patorjk.com/software/taag/#p=display&f=Ogre&t=main%20stage

#  _                 _       _                   
# | | ___   ___ __ _| |  ___| |_ __ _  __ _  ___ 
# | |/ _ \ / __/ _` | | / __| __/ _` |/ _` |/ _ \
# | | (_) | (_| (_| | | \__ \ || (_| | (_| |  __/
# |_|\___/ \___\__,_|_| |___/\__\__,_|\__, |\___|
#                                     |___/     
aws_local_cli_profile=3dpvagls #indentifier
aws_local_account_id=<your_account_id> #example: 891376944014
# Must be supported Amazon GameLift Streams primary region, see: https://docs.aws.amazon.com/gameliftstreams/latest/developerguide/regions-quotas-rande.html
aws_local_region=<deployment_region> #example: us-west-2
aws_local_deploy_id=v-000 #indentifier
aws_local_cdk_qualifier=pvaglsv000 #indentifier

aws_local_gls_stream_group_id=<your stream group arn> #example: arn:aws:gameliftstreams:us-west-2:895576944014:streamgroup/sg-a3J708bpJ
aws_local_gls_application_id=<your application arn> #example: arn:aws:gameliftstreams:us-west-2:895576944014:application/a-qAtUGMG69
#   ___ _ __   __| | | | ___   ___ __ _| |  ___| |_ __ _  __ _  ___ 
#  / _ \ '_ \ / _` | | |/ _ \ / __/ _` | | / __| __/ _` |/ _` |/ _ \
# |  __/ | | | (_| | | | (_) | (_| (_| | | \__ \ || (_| | (_| |  __/
#  \___|_| |_|\__,_| |_|\___/ \___\__,_|_| |___/\__\__,_|\__, |\___|
#                                                        |___/      

#                  _             _                   
#  _ __ ___   __ _(_)_ __    ___| |_ __ _  __ _  ___ 
# | '_ ` _ \ / _` | | '_ \  / __| __/ _` |/ _` |/ _ \
# | | | | | | (_| | | | | | \__ \ || (_| | (_| |  __/
# |_| |_| |_|\__,_|_|_| |_| |___/\__\__,_|\__, |\___|
#                                         |___/      
aws_main_cli_profile=pviz1 #indentifier
aws_main_account_id=<your_account_id> #example: 001376944014
# Must be supported Amazon GameLift Streams primary region, see: https://docs.aws.amazon.com/gameliftstreams/latest/developerguide/regions-quotas-rande.html
aws_main_region=<deployment_region> #example: us-west-2
aws_main_deploy_id=v-001 #indentifier
aws_main_cdk_qualifier=pvaglsv001 #indentifier
#                 _                   _             _                   
#   ___ _ __   __| |  _ __ ___   __ _(_)_ __    ___| |_ __ _  __ _  ___ 
#  / _ \ '_ \ / _` | | '_ ` _ \ / _` | | '_ \  / __| __/ _` |/ _` |/ _ \
# |  __/ | | | (_| | | | | | | | (_| | | | | | \__ \ || (_| | (_| |  __/
#  \___|_| |_|\__,_| |_| |_| |_|\__,_|_|_| |_| |___/\__\__,_|\__, |\___|
