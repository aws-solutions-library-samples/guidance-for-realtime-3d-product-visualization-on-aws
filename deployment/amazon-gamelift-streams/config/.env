# We put the CloudFormation (cfn) stack export name suffixes in this file since, outside of exporting from cfn, we mostly need them in scripts.
# It's far easier to go from here -> TypeScript than the reverse.
aws_cicd_source_code_bucket_name_cfn_export_name_suffix=SourceCodeBucketName

aws_backend_app_access_logs_bucket_name_cfn_export_name_suffix=AppAccessLogsBucketName
aws_backend_app_bucket_name_cfn_export_name_suffix=AppBucketName
aws_backend_gls_application_id_cfn_export_name_suffix=GLSAppId
aws_backend_gls_stream_group_id_cfn_export_name_suffix=GLSStreamGroupId

aws_frontend_waf_ip_set_id_cfn_export_name_suffix=IpSetId
aws_frontend_waf_web_acl_attr_arn_cfn_export_name_suffix=WebAclAttrARN
# aws_frontend_cloudtrail_arn_cfn_export_name_suffix=CloudTrailName
# aws_frontend_cloudtrail_bucket_name_cfn_export_name_suffix=CloudtrailBucketName

aws_frontend_cloudfront_access_logs_bucket_name_cfn_export_name_suffix=CloudFrontAccessLogsBucketName
aws_frontend_website_bucket_name_cfn_export_name_suffix=WebsiteBucketName
aws_frontend_website_url_cfn_export_name_suffix=AppURL
aws_frontend_distribution_id_cfn_export_name_suffix=CloudFrontDistributionID