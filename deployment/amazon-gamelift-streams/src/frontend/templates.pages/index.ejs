<!DOCTYPE html>
<html lang='en'>
<%- include(`${process.cwd()}/src/frontend/templates.partials/head`); -%>
<body>
  <main class='container'>
    <h3>3D Product Visualizer</h3>
    <button id='start-product-visualizer'>Start</button>
    <captcha-captcha id='stream-captcha' class='captcha-captcha'></captcha-captcha>
    <div id='pvagls' hidden>
      <status-display id='stream-status' class='status-display'>
        <span id='loading' class='loader'></span>
      </status-display>
      <video id='pvagls-video' autoplay playsinline></video>
      <audio id='pvagls-audio' autoplay></audio>
    </div>
  </main>
  <%- include(`${process.cwd()}/src/frontend/templates.partials/footer`); -%>
</body>
</html>